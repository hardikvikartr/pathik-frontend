{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/pending-checkout/layout,_N_T_/dashboard/pending-checkout/page,_N_T_/dashboard/pending-checkout"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/pending-checkout/__PAGE__",
    "/dashboard/pending-checkout",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}